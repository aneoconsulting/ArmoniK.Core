{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Grpc": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Properties": {
      "Application": "ArmoniK.Core.Standalone"
    }
  },
  "Standalone": {
    "Slots": 1,
    "DataFolder": "data",
    "GrpcPort": 5001,
    "HttpPort": 5002,
    "ListenAnyIP": false,
    "SocketType": "UnixDomainSocket",
    "WorkerAddress": "{data}/slot{slot}/worker.sock",
    "AgentAddress": "{data}/slot{slot}/agent.sock"
  },
  "Submitter": {
    "DefaultPartition": "default"
  },
  "Pollster": {
    "PartitionId": "default",
    "GraceDelay": "00:00:05"
  },
  "InitWorker": {
    "WorkerCheckRetries": 1800,
    "WorkerCheckDelay": "00:00:02"
  },
  "InitServices": {
    "Partitioning": {
      "Partitions": [
        "{\"PartitionId\":\"default\",\"Priority\":1,\"PodReserved\":1,\"PodMax\":100,\"PreemptionPercentage\":0,\"ParentPartitionIds\":[],\"PodConfiguration\":null}"
      ]
    }
  },
  "Authenticator": {
    "CNHeader": "X-Certificate-Client-CN",
    "FingerprintHeader": "X-Certificate-Client-Fingerprint",
    "ImpersonationUsernameHeader": "X-Impersonate-Username",
    "ImpersonationIdHeader": "X-Impersonate-Id",
    "RequireAuthentication": false,
    "RequireAuthorization": false
  }
}
