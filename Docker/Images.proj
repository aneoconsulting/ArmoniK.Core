<!--
  Restores, builds and publishes every project shipped in the core Docker images (see the root Dockerfile).

  Traversal project (https://github.com/microsoft/MSBuildSdks/tree/main/src/Traversal):
  - `dotnet restore` restores the whole project graph in a single pass;
  - the PublishImages target builds the projects in parallel, then publishes them
    in parallel without rebuilding, each one into $(PublishRoot)<PublishSubDir>/.

  See the restore and publish RUN commands of the root Dockerfile for the expected invocations.
-->
<Project Sdk="Microsoft.Build.Traversal/4.1.82">
  <PropertyGroup>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)../publish/</PublishRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Adaptors/SQS/src/ArmoniK.Core.Adapters.SQS.csproj" PublishSubDir="sqs" />
    <ProjectReference Include="../Adaptors/PubSub/src/ArmoniK.Core.Adapters.PubSub.csproj" PublishSubDir="pubsub" />
    <ProjectReference Include="../Adaptors/Nats/src/ArmoniK.Core.Adapters.Nats.csproj" PublishSubDir="nats" />
    <ProjectReference Include="../Adaptors/Amqp/src/ArmoniK.Core.Adapters.Amqp.csproj" PublishSubDir="amqp" />
    <ProjectReference Include="../Adaptors/LocalStorage/src/ArmoniK.Core.Adapters.LocalStorage.csproj" PublishSubDir="local_storage" />
    <ProjectReference Include="../Adaptors/Embed/src/ArmoniK.Core.Adapters.Embed.csproj" PublishSubDir="embed" />
    <ProjectReference Include="../Adaptors/NullStorage/src/ArmoniK.Core.Adapters.NullStorage.csproj" PublishSubDir="null_storage" />
    <ProjectReference Include="../Adaptors/Redis/src/ArmoniK.Core.Adapters.Redis.csproj" PublishSubDir="redis" />
    <ProjectReference Include="../Adaptors/S3/src/ArmoniK.Core.Adapters.S3.csproj" PublishSubDir="s3" />
    <ProjectReference Include="../Adaptors/Gcs/src/ArmoniK.Core.Adapters.Gcs.csproj" PublishSubDir="gcs" />
    <ProjectReference Include="../Compute/PollingAgent/src/ArmoniK.Core.Compute.PollingAgent.csproj" PublishSubDir="polling_agent" />
    <ProjectReference Include="../Control/Metrics/src/ArmoniK.Core.Control.Metrics.csproj" PublishSubDir="metrics" />
    <ProjectReference Include="../Control/Submitter/src/ArmoniK.Core.Control.Submitter.csproj" PublishSubDir="submitter" />
  </ItemGroup>

  <!--
    PublishDir is set only for the publish step: as a global property it flows to the
    referenced projects (Common, Base...), so setting it during the build would create one
    build of each shared dependency per published project, compiled concurrently in the same
    obj folder.
  -->
  <Target Name="PublishImages" DependsOnTargets="Build">
    <ItemGroup>
      <_ImageProjectToPublish Include="@(ProjectReference)" AdditionalProperties="NoBuild=true;PublishDir=$(PublishRoot)%(ProjectReference.PublishSubDir)/" />
    </ItemGroup>
    <MSBuild Projects="@(_ImageProjectToPublish)" Targets="Publish" BuildInParallel="$(BuildInParallel)" />
  </Target>
</Project>
